// LUCIAN Vault — Prisma schema (BACKEND FOUNDATION CORRECTED).
//
// Authoritative financial state lives here, in Postgres (Neon for Vercel).
// NEVER use SQLite. NEVER use process-memory as the source of truth for
// provider-backed money.
//
// DATABASE SETUP:
//   1. Set DATABASE_URL to a Postgres connection string (Neon, Supabase, etc.).
//   2. Run: npx prisma migrate deploy   (production)
//      or:  npx prisma migrate dev --name vault_foundation_corrected  (dev)
//   3. The Prisma client is exposed via src/lib/db.ts (server-only).
//
// If DATABASE_URL is missing OR points to a non-Postgres URL, the Vault
// API endpoints for provider-backed operations REFUSE to act. Manual
// (self-reported) accounts continue to work via the client Zustand store.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ── Vault accounts ──
 */
//
// `source` distinguishes:
//   - "manual"     : self-reported by the user (UI only, not authoritative money)
//   - "provider"   : provider-verified, ledger-derived
//
// `ownerUserId` and `ownerAccountId` are reserved for Phase 16 (Auth).
// Until Auth exists, provider-backed LIVE money is disabled at the API layer,
// so these fields can stay null. They are present in the schema so that
// records never become a globally shared dataset when auth lands.

model VaultAccount {
  id       String  @id @default(cuid())
  label    String
  type     String // bank | card | crypto-wallet | brokerage | trading
  source   String // manual | provider
  provider String?
  maskedId String?
  balance  BigInt  @default(0) // display-only cache; authoritative money is ledger-derived
  currency String  @default("USD")
  note     String?

  // Provider linkage
  providerConnectionId String?
  depositEligible      Boolean @default(false)
  withdrawalEligible   Boolean @default(false)

  // Phase 16 (Auth) preparation — never populated until Auth exists.
  ownerUserId    String?
  ownerAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries  LedgerEntry[]
  balanceHistory BalanceHistory[]
  paymentMethods PaymentMethod[]
  bankAccounts   BankAccount[]
  transactions   VaultTransaction[]

  @@index([source])
  @@index([type])
  @@index([ownerUserId])
}

/**
 * ── Ledger entries (immutable, append-only) ──
 * Balanced double-entry accounting. Every entry has a DISTINCT debit and
 * credit account. The invariant `debitAccount !== creditAccount` is
 * enforced both at the type layer and by the ledger service at write time.
 * Account identifiers (kept as strings for forward-compat):
 * - provider-clearing      : external money in transit to/from a provider
 * - cash-pending           : inbound funds awaiting provider settlement
 * - cash-available          : settled, withdrawable cash
 * - cash-reserved           : holds (e.g. open withdrawal requests)
 * - withdrawal-pending      : outbound funds awaiting provider completion
 * - trading-cash            : cash inside the brokerage
 * - trading-reserved        : cash reserved for open orders
 * - trading-buying-power    : brokerage buying power (provider-supplied)
 * - trading-positions       : market value of open positions
 * - crypto-custody          : crypto held by the custodian
 * - fee-account            : fees collected
 * Reference flows:
 * DEPOSIT (initiated):     provider-clearing  →  cash-pending
 * DEPOSIT (settled, webhook): cash-pending    →  cash-available
 * WITHDRAWAL (requested):  cash-available     →  withdrawal-pending
 * WITHDRAWAL (completed):  withdrawal-pending →  provider-clearing
 * WITHDRAWAL (failed):     withdrawal-pending →  cash-available   (release)
 * INTERNAL TRANSFER:       <source>           →  <destination>
 * FEE:                     <source>           →  fee-account
 * `idempotencyKey` is unique — attempting to append a second entry with
 * the same key is rejected and the original is returned.
 */

model LedgerEntry {
  id              String  @id @default(cuid())
  // User-scoped idempotency. Same (ownerUserId, idempotencyKey) returns
  // the existing entry; the same key under a different user is a
  // completely independent operation. NULL ownerUserId is reserved for
  // the webhook / system pipeline (legacy global keys).
  idempotencyKey  String
  providerEventId String?
  providerTxId    String?
  type            String // deposit | withdrawal | internal-transfer | trade | fee | adjustment | reservation | release | settlement
  status          String // requested | pending | processing | requires-action | completed | failed | cancelled
  debitAccount    String // NEVER equal to creditAccount
  creditAccount   String // NEVER equal to debitAccount
  amount          BigInt // minor units (always positive)
  currency        String

  source      String
  destination String
  provider    String?
  asset       String?
  network     String?
  metadata    Json?

  // Link to the user-facing VaultTransaction (one LedgerEntry may belong
  // to exactly one VaultTransaction; the transaction aggregates the
  // lifecycle of a single user intent across multiple ledger entries).
  transactionId String?
  transaction   VaultTransaction? @relation(fields: [transactionId], references: [id])

  // Phase 16 (Auth) preparation.
  ownerUserId String?

  timestamp DateTime @default(now())

  account   VaultAccount? @relation(fields: [accountId], references: [id])
  accountId String?

  @@unique([ownerUserId, idempotencyKey])
  @@index([status])
  @@index([type])
  @@index([provider])
  @@index([providerEventId])
  @@index([providerTxId])
  @@index([transactionId])
  @@index([timestamp])
  @@index([ownerUserId])
  // Preserve the legacy lookup-by-key-only path so webhook dedupe
  // (which resolves ownerUserId from the transaction before writing)
  // can still locate an existing entry by idempotencyKey alone.
  @@index([idempotencyKey])
}

/**
 * ── Vault transactions (user-facing financial activity) ──
 * A VaultTransaction is the user's view of a financial intent ("I added
 * $500 via card X"). It links to one or more LedgerEntry rows that move
 * money through the balanced accounting pipeline.
 * Status transitions are explicit and enforced (see
 * src/lib/vault/transitions.ts):
 * requested   → pending | failed | cancelled
 * pending     → processing | requires-action | failed | cancelled
 * processing  → completed | failed
 * requires-action → processing | failed | cancelled
 * completed   → (terminal)
 * failed      → (terminal; recovery requires a NEW transaction)
 * cancelled   → (terminal)
 * `failed → completed` is FORBIDDEN. If a provider genuinely reverses a
 * failure, a NEW VaultTransaction is created with type=adjustment and a
 * linked `reversalOfId`.
 * Linking fields — provider events locate the original transaction by:
 * 1. providerTxId  (preferred — set by the API on initiation)
 * 2. providerEventId (recorded on the originating transaction as a hint)
 * 3. idempotencyKey (last resort — the original request key)
 */

model VaultTransaction {
  id                    String        @id @default(cuid())
  lucianTxId            String        @unique // public-facing ID, e.g. "dep_..."
  type                  String // deposit | withdrawal | internal-transfer | trade | fee | adjustment
  status                String // requested | pending | processing | requires-action | completed | failed | cancelled
  currency              String
  asset                 String?
  network               String?
  amount                BigInt // minor units, positive
  source                String
  destination           String
  provider              String?
  providerTransactionId String?
  providerEventId       String?
  idempotencyKey        String?
  userId                String? // Phase 16 (Auth) preparation
  accountId             String?
  account               VaultAccount? @relation(fields: [accountId], references: [id])
  reversalOfId          String? // set on adjustment transactions that reverse a prior one
  metadata              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([status])
  @@index([type])
  @@index([provider])
  @@index([providerTransactionId])
  @@index([providerEventId])
  @@index([userId])
  @@index([createdAt])
}

/**
 * ── Balance history (snapshot on every authoritative change) ──
 */

model BalanceHistory {
  id         String   @id @default(cuid())
  accountId  String
  oldBalance BigInt
  newBalance BigInt
  currency   String
  reason     String
  timestamp  DateTime @default(now())

  account VaultAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([timestamp])
}

/**
 * ── Payment methods (cards) — safe references only ──
 */

model PaymentMethod {
  id                      String  @id @default(cuid())
  providerPaymentMethodId String  @unique // Stripe pm_...
  brand                   String // visa | mastercard | amex | discover
  last4                   String
  expiryMonth             Int
  expiryYear              Int
  isDefault               Boolean @default(false)
  depositEligible         Boolean @default(true)
  withdrawalEligible      Boolean @default(false)

  displayName String

  accountId String?
  account   VaultAccount? @relation(fields: [accountId], references: [id])

  // Phase 16 (Auth) preparation.
  ownerUserId String?

  createdAt DateTime @default(now())

  @@index([brand])
  @@index([ownerUserId])
}

/**
 * ── Bank accounts ──
 */

model BankAccount {
  id                    String  @id @default(cuid())
  providerBankAccountId String  @unique
  bankName              String
  accountType           String // checking | savings
  last4                 String
  verified              Boolean @default(false)
  depositEligible       Boolean @default(true)
  withdrawalEligible    Boolean @default(true)
  displayName           String

  accountId String?
  account   VaultAccount? @relation(fields: [accountId], references: [id])

  // Phase 16 (Auth) preparation.
  ownerUserId String?

  createdAt DateTime @default(now())

  @@index([ownerUserId])
}

/**
 * ── Crypto wallets ──
 */

model CryptoWallet {
  id                      String  @id @default(cuid())
  asset                   String // BTC | ETH | USDC | SOL
  network                 String // bitcoin | ethereum | solana | etc.
  address                 String
  label                   String
  isWithdrawalDestination Boolean @default(false)

  // Phase 16 (Auth) preparation.
  ownerUserId String?

  createdAt DateTime @default(now())

  @@unique([asset, network, address])
  @@index([asset, network])
  @@index([ownerUserId])
}

/**
 * ── Withdrawal destinations ──
 * `approvedAt` is the time at which the destination becomes usable.
 * Until `approvedAt <= now()`, withdrawals to this destination are blocked.
 */

model WithdrawalDestination {
  id          String    @id @default(cuid())
  type        String // bank | card | crypto
  referenceId String?
  label       String
  asset       String    @default("USD")
  network     String?
  address     String? // stored masked on read; full address kept server-side
  approved    Boolean   @default(false)
  approvedAt  DateTime?

  // Phase 16 (Auth) preparation.
  ownerUserId String?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([approved])
  @@index([ownerUserId])
}

/**
 * ── Provider connections ──
 * `state` is the HONEST connection state, distinct from `configured`.
 * not_configured : env vars missing
 * configured     : env vars present (adapter can be constructed)
 * setup_required : env vars present, but adapter is a stub OR user has
 * not yet completed the provider-side link flow
 * connecting     : user is mid-flow (e.g. Plaid Link modal open)
 * connected      : a genuine provider-side account link exists
 * restricted    : provider returned a restricted / limited state
 * error          : provider-side error; needs human attention
 * Stubs (Stripe/Plaid/Alpaca without SDK) are ALWAYS at most
 * `setup_required`, never `connected`, regardless of env keys.
 */

model ProviderConnection {
  id          String @id @default(cuid())
  type        String // payment | bank | crypto | broker
  name        String // stripe | plaid | bybit | alpaca
  state       String @default("not_configured")
  displayName String

  // Encrypted tokens (use VAULT_ENCRYPTION_KEY) — populated only when state=connected
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?

  // Phase 16 (Auth) preparation.
  ownerUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@index([ownerUserId])
}

/**
 * ── Processed provider events (durable idempotency for webhooks) ──
 */

model ProcessedProviderEvent {
  id             String   @id @default(cuid())
  provider       String
  eventId        String
  eventType      String?
  ledgerEntryIds String[] // LedgerEntry IDs created from this event
  transactionId  String? // VaultTransaction updated by this event
  rawPayloadHash String // SHA-256 hex of the raw payload
  processedAt    DateTime @default(now())

  // Phase 16 (Auth) preparation.
  ownerUserId String?

  @@unique([provider, eventId])
  @@index([provider])
  @@index([transactionId])
  @@index([ownerUserId])
}

/**
 * ── Idempotency records (durable, DB-backed) ──
 * Same key + same requestHash  → return the cached response.
 * Same key + different hash    → 409 Conflict (key reuse).
 * Records auto-expire after `expiresAt`. TTL is 24h by default.
 */

model IdempotencyRecord {
  id          String   @id @default(cuid())
  // User-scoped idempotency. Same (ownerUserId, key) returns the existing
  // record; the same key under a different user is a completely independent
  // operation. NULL ownerUserId is kept for legacy / system-initiated
  // writes that don't carry an owner.
  ownerUserId String?
  key         String
  requestHash String
  response    Json
  status      Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([ownerUserId, key])
  @@index([expiresAt])
  @@index([ownerUserId])
  @@index([key])
}

/**
 * ── Auto Fund configuration ──
 */

model AutoFundConfig {
  id                   String  @id @default("default")
  enabled              Boolean @default(false)
  fundingSourceId      String?
  fundingSourceType    String? // card | bank
  lowBalanceThreshold  BigInt  @default(100000) // $1000 in cents
  topUpAmount          BigInt  @default(300000)
  dailyLimit           BigInt  @default(1000000)
  monthlyLimit         BigInt  @default(3000000)
  maxSingleTopUp       BigInt  @default(500000)
  minTriggerIntervalMs BigInt  @default(3600000) // 1 hour
  maxRetries           Int     @default(3)
  providerReady        Boolean @default(false)

  // Phase 16 (Auth) preparation.
  ownerUserId String?

  updatedAt DateTime @updatedAt
}

/**
 * ── Vault security settings ──
 */

model VaultSecuritySettings {
  id                             String  @id @default("default")
  requireWithdrawalVerification  Boolean @default(true)
  twoFactorRequired              Boolean @default(false)
  twoFactorConfigured            Boolean @default(false)
  newDestinationDelayHours       Int     @default(24)
  dailyFiatWithdrawalLimit       BigInt  @default(1000000) // $10,000
  dailyCryptoWithdrawalLimitFiat BigInt  @default(500000) // $5,000
  largeTransactionThreshold      BigInt  @default(100000) // $1,000
  cryptoAddressAllowlist         Json    @default("[]")
  newDeviceWithdrawalRestriction Boolean @default(true)
  maskSensitiveValues            Boolean @default(false)
  sessionTimeoutMin              Int     @default(30)

  // Phase 16 (Auth) preparation.
  ownerUserId String?

  updatedAt DateTime @updatedAt
}

/**
 * ════════════════════════════════════════════════════════════════════════════
 * PHASE 16 — AUTHENTICATION + USER OWNERSHIP  (FINAL CORRECTED)
 * ════════════════════════════════════════════════════════════════════════════
 * Architecture (Auth.js v5, FINAL):
 * - Session strategy = JWT (HttpOnly, Secure, SameSite=Lax cookie).
 * This is REQUIRED by the Auth.js Credentials provider — combining
 * Credentials with the database session strategy is forbidden by
 * Auth.js v5 and silently breaks sign-in. The previous project
 * revision had this bug; it is corrected here.
 * - User / Profile / PasswordResetToken / chats / notifications /
 * SavedItem / ArchivedAssistantMemory — all real rows in Neon.
 * - Account model field names use snake_case to EXACTLY match what
 * the @auth/prisma-adapter writes (refresh_token, access_token,
 * expires_at, token_type, id_token, session_state). Without
 * this, OAuth writes fail silently because the adapter passes
 * snake_case keys to Prisma.create().
 * - Session table is kept for legacy compatibility but is NOT used
 * by Auth.js when strategy=jwt. The /api/auth/sessions endpoint
 * honestly reports JWT-only mode.
 * Ownership rules:
 * - userId is ALWAYS derived from the authenticated session on the server
 * - Never trust userId from the request body
 * - All queries scope by userId / ownerUserId
 * - Cross-user access must be impossible at the query layer
 * Password storage:
 * - bcryptjs (pure-JS, Vercel-serverless-safe) hash with cost factor 12
 * - passwordHash is NEVER returned to the client (Prisma `select` excludes it)
 * - Plain-text password is NEVER logged or persisted
 * Migration chain (FRESH-EMPTY-DB SAFE):
 * - One consolidated init migration creates every Vault + Auth + user-data
 * table in the correct FK order. There are no ALTER-only migrations that
 * assume pre-existing tables. `npx prisma migrate deploy` on a totally
 * empty Postgres database succeeds end-to-end.
 * - All `ownerUserId` / `userId` columns are nullable TEXT without FK so
 * legacy rows from before Phase 16 don't break the schema.
 */

/**
 * ── User ──
 */

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  username       String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  passwordHash   String?
  status         String    @default("active")
  // JWT revocation version. The JWT carries the version that was current
  // at sign-in; every authenticated server-side resolution compares the
  // JWT version against this column. Password change / reset / security
  // reset bump it, invalidating every previously-issued JWT for this user.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  profile                Profile?
  passwordResetTokens    PasswordResetToken[]
  archivedConversations  ArchivedChatConversation[]
  archivedAssistantMemory ArchivedAssistantMemory[]
  notifications          UserNotification[]
  savedItems             SavedItem[]
  dataMigrations         UserDataMigration[]
  cloudProjects          CloudWorkspaceProject[]
  tradingSandbox         TradingSandboxAccount?
  exchangeConnections    ExchangeConnection[]
  tradingAgentProfile    TradingAgentProfile?
  liveTradeIntents       LiveTradeIntent[]
  tradingAuditEvents     TradingAuditEvent[]
  cryptoReceiveAddresses CryptoReceiveAddress[]
  cryptoTransferIntents  CryptoTransferIntent[]
  ownerCredentials       OwnerCredential[]

  @@index([status])
  @@index([username])
}

/**
 * Owner-only secrets. Values are AES-256-GCM envelopes; plaintext is never
 * persisted or returned by an API. AAD binds each value to owner/service/key.
 */
model OwnerCredential {
  id             String   @id @default(cuid())
  ownerUserId    String
  service        String
  keyName        String
  encryptedValue String
  keyVersion     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, service, keyName])
  @@index([service, keyName])
}

/**
 * Durable authentication throttling shared by every production instance.
 * The id is an HMAC bucket identifier; raw client network addresses are never
 * persisted. Expired buckets may be deleted by routine maintenance.
 */
model AuthRateLimit {
  id          String   @id
  scope       String
  count       Int      @default(1)
  windowStart DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
  @@index([scope, windowStart])
}

/**
 * Authenticated cloud snapshot for DevWorkspace. The browser IndexedDB copy
 * remains an offline cache; this row is the cross-tab/device source of truth.
 */
model CloudWorkspaceProject {
  id        String   @id
  userId    String
  project   Json
  contents  Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
  @@index([userId, updatedAt])
}

/**
 * Persistent paper/sandbox account. Values are stored as a versioned JSON
 * snapshot because the existing trading engine has a rich order shape.
 */
model TradingSandboxAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  state     Json
  history   Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Per-user exchange OAuth credentials. Tokens are always AES-256-GCM
 * encrypted before persistence and never returned to the browser.
 */
model ExchangeConnection {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  state           String   @default("connected")
  accessTokenEnc  String
  refreshTokenEnc String?
  tokenExpiresAt  DateTime
  scope           String?
  portfolioId     String?
  providerUserId  String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, state])
}

/**
 * Server-authoritative real-trading permission envelope. Seeing the Bybit
 * account balance never grants spending authority: allocationUsd is the hard
 * ceiling assigned to LUCIAN's Economic Agent.
 */
model TradingAgentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  allocationUsd  Decimal  @default(0) @db.Decimal(18, 8)
  maxOrderUsd    Decimal  @default(50) @db.Decimal(18, 8)
  permissionMode String   @default("assisted") // advisor | assisted | operator | autonomous
  emergencyStop  Boolean  @default(false)
  maxPositionUsd Decimal  @default(2500) @db.Decimal(18, 8)
  maxDailyLossUsd Decimal @default(250) @db.Decimal(18, 8)
  maxOpenPositions Int    @default(5)
  maxLeverage     Decimal @default(3) @db.Decimal(8, 2)
  requireApproval Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Immutable-enough audit record for every preview and submitted live order.
 * Provider payloads are retained for reconciliation without exposing secrets.
 */
model LiveTradeIntent {
  id              String    @id @default(cuid())
  userId          String
  clientOrderId   String    @unique
  providerOrderId String?
  previewId       String?
  productId       String
  side            String
  tradingMode     String    @default("bybit_testnet")
  category        String    @default("spot")
  orderType       String    @default("Market")
  limitPrice      Decimal?  @db.Decimal(30, 12)
  stopLoss        Decimal?  @db.Decimal(30, 12)
  takeProfit      Decimal?  @db.Decimal(30, 12)
  quoteSize       Decimal?  @db.Decimal(30, 12)
  baseSize        Decimal?  @db.Decimal(30, 12)
  initiatedBy     String    @default("user")
  state           String    @default("previewed")
  preview         Json?
  execution       Json?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state, createdAt])
  @@index([userId, productId, createdAt])
}

/** Owner-visible, append-only record of sensitive trading actions. */
model TradingAuditEvent {
  id          String   @id @default(cuid())
  userId      String
  action      String
  tradingMode String
  status      String
  symbol      String?
  intentId    String?
  details     Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action, status])
}

/**
 * Exchange deposit addresses. Addresses are not secrets, but are
 * scoped to their authenticated owner and retained for cross-device history.
 */
model CryptoReceiveAddress {
  id                String   @id @default(cuid())
  userId            String
  provider          String   @default("bybit")
  exchangeAccountId String
  providerAddressId String
  asset             String
  network           String
  address           String
  tag               String?
  label             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerAddressId])
  @@index([userId, asset, network, createdAt])
}

/**
 * Owner-controlled outbound exchange withdrawals. A preview expires quickly and
 * can be submitted only once after password re-verification and an exact
 * confirmation phrase. The Economic Agent has no relationship or tool that
 * can confirm one of these records.
 */
model CryptoTransferIntent {
  id                    String    @id @default(cuid())
  userId                String
  provider              String    @default("bybit")
  idempotencyKey        String    @unique
  exchangeAccountId     String
  asset                 String
  network               String
  destination           String
  destinationTag        String?
  amount                Decimal   @db.Decimal(36, 18)
  estimatedUsd          Decimal   @db.Decimal(24, 8)
  confirmationText      String
  state                 String    @default("previewed")
  providerTransactionId String?
  providerResponse      Json?
  expiresAt             DateTime
  confirmedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state, createdAt])
  @@index([userId, providerTransactionId])
}

/**
 * ── Account ── (OAuth provider accounts, managed by Auth.js Prisma adapter)
 * Field names MUST be snake_case to match the official @auth/prisma-adapter
 * schema. The adapter writes fields like `refresh_token`, `access_token`,
 * `expires_at`, `token_type`, `id_token`, `session_state` directly via
 * Prisma.create — using camelCase Prisma field names without `@map`
 * causes the write to fail.
 */

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/**
 * ── Session ── (kept for legacy compatibility; NOT used under JWT strategy)
 */

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expires])
}

/**
 * ── VerificationToken ── (Auth.js email + OAuth verification)
 */

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  createdAt DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
}

/**
 * ── Profile ── (one-to-one with User; display-facing fields)
 */

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  avatar      String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * ── PasswordResetToken ── (one-time, expiring, user-bound)
 */

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * ── ArchivedChatConversation ── historical records, account-export only.
 * No provider, chat API, hydration, sync, or assistant reads these records.
 * Physical tables and migration history remain intact; no destructive migration.
 */

model ArchivedChatConversation {
  id        String   @id @default(cuid())
  userId    String
  source    String
  title     String
  model     String?
  provider  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ArchivedChatMessage[]

  @@map("ChatConversation")
  @@index([userId, source])
  @@index([updatedAt])
}

/**
 * ── ArchivedChatMessage ──
 */

model ArchivedChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  // Stable client-supplied dedupe id. When the client retries a sync
  // (network down) with the same messageId, the server returns the
  // existing row instead of creating a duplicate. NULL is allowed for
  // legacy / server-only messages that don't carry a client id.
  messageId      String?
  role           String
  content        String
  model          String?
  provider       String?
  createdAt      DateTime @default(now())

  conversation ArchivedChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ChatMessage")
  @@unique([conversationId, messageId])
  @@index([conversationId, createdAt])
}

/**
 * ── ArchivedAssistantMemory ── historical export-only rows; not runtime memory.
 */

model ArchivedAssistantMemory {
  id        String   @id @default(cuid())
  userId    String
  scope     String   @default("user")
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AgentMemory")
  @@unique([userId, scope, key])
  @@index([userId, scope])
}

/**
 * ── UserNotification ── (server-backed user-owned notifications)
 */

model UserNotification {
  id            String    @id @default(cuid())
  userId        String
  source        String
  title         String
  message       String
  level         String    @default("info")
  actionable    Boolean   @default(false)
  resolved      Boolean   @default(false)
  readAt        DateTime?
  dismissedAt   DateTime?
  dedupeKey     String?
  entityRef     String?
  deepLink      String?
  lastTriggerAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/**
 * ── SavedItem ── (user-owned bookmarks / favorites across modules)
 */

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  source    String
  type      String
  refId     String?
  title     String
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, refId])
  @@index([userId, source])
  @@index([userId, createdAt])
}

/**
 * ── UserDataMigration ── (local -> server migration state per user/category)
 */

model UserDataMigration {
  id          String    @id @default(cuid())
  userId      String
  category    String
  status      String    @default("pending")
  version     Int       @default(1)
  recordCount Int       @default(0)
  migratedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, version])
  @@index([userId, status])
}
