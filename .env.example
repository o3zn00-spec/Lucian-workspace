# Private local LUCIAN development. Copy to .env.local and configure manually.
# No production credentials or existing database paths are supplied.
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000
AUTH_APP_URL=http://127.0.0.1:3000
LUCIAN_OWNER_EMAIL=
LUCIAN_OWNER_USERNAME=
LUCIAN_OWNER_PASSWORD=
LUCIAN_OWNER_RECOVERY_PASSWORD=
OWNER_CREDENTIALS_ENCRYPTION_KEY=
VAULT_ENCRYPTION_KEY=
TRADING_MODE=sandbox
NEXT_PUBLIC_TRADING_MODE=sandbox
LIVE_TRADING_ENABLED=false
BYBIT_LIVE_MODE_ENABLED=false
BYBIT_TESTNET_TRADING_ENABLED=false
BYBIT_WITHDRAWALS_ENABLED=false
BYBIT_ENVIRONMENT=testnet
BYBIT_API_KEY=
BYBIT_API_SECRET=
MAX_LIVE_ORDER_QUOTE=50
MAX_LIVE_ORDER_USD=50
BYBIT_MAX_WITHDRAW_USD=50
BYBIT_WITHDRAW_ALLOWED_ASSETS=
BYBIT_WITHDRAW_ALLOWED_NETWORKS=
ENABLE_SANDBOX_FUNDING=false
NEXT_PUBLIC_TRADING_CLOUD_SYNC_ENABLED=false
NEXT_PUBLIC_WORKSPACE_CLOUD_SYNC_ENABLED=false
WORKSPACE_MAX_PROJECT_BYTES=26214400
WORKSPACE_MAX_FILE_BYTES=5242880
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
BANK_PROVIDER_CLIENT_ID=
BANK_PROVIDER_SECRET=
BANK_PROVIDER_ENV=sandbox
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_API_BASE_URL=
BROKER_WEBHOOK_SECRET=
NEXT_TELEMETRY_DISABLED=1

# Maintenance tools only. Never point restore at the live LUCIAN database.
BACKUP_DIR=./backups
RESTORE_DATABASE_URL=
PGSSLMODE=prefer
