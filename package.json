    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "idb": "^8.0.3",
    "imagetracerjs": "^1.2.6",
    "jose": "^6.2.10",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.460.0",
    "monaco-editor": "^0.56.0",
    "next": "16.3.6",
