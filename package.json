{
  "name": "lucian-workspace",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:phase12": "tsx scripts/phase12-control-audit.ts && tsx scripts/phase12-architecture-tests.ts",
    "audit:phase13": "tsx scripts/phase12-control-audit.ts && tsx scripts/phase12-architecture-tests.ts && tsx scripts/phase13-production-audit.ts && tsx scripts/production-readiness.ts",
    "readiness:production": "tsx scripts/production-readiness.ts --environment",
    "verify:live": "tsx scripts/live-readiness.ts",
    "backup:database": "tsx scripts/database-maintenance.ts backup",
    "verify:backup": "tsx scripts/database-maintenance.ts verify",
    "restore:database": "tsx scripts/database-maintenance.ts restore",
    "recover:owner": "tsx scripts/recover-owner.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "test:desktop": "node --test desktop/*.test.mjs",
    "test:architecture": "tsx scripts/phase10-architecture-tests.ts && tsx scripts/phase12-architecture-tests.ts && tsx scripts/vault-architecture-tests.ts",
    "desktop:dev": "node desktop/launch.mjs",
    "desktop:host": "node desktop/host.mjs",
    "desktop:stage": "node desktop/package-runtime.mjs",
    "test:consolidation": "node --test scripts/consolidation-tests.mjs"
  },
  "dependencies": {
